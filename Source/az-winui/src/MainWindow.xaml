<Window
    x:Class="AccessibilityZoom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Accessibility Zoom">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Card: the frosted panel floating over Mica. Theme-aware brushes
                 keep it correct in light and dark mode automatically.
                 (WinUI 3 Window has no Resources property, so page styles live here.) -->
            <Style x:Key="CardPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="HeroReadoutStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="44" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="52" />
            </Style>
            <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SliderRowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SliderValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Storyboard x:Name="EntranceStoryboard">
                <!-- Opacity-only entrance: a DoubleAnimation targeting
                     (UIElement.Translation).Y parses but throws
                     0x800F1000 ("Cannot resolve TargetProperty") in
                     Storyboard.Begin(), taking the app down. -->
                <DoubleAnimation
                    Storyboard.TargetName="ContentRoot"
                    Storyboard.TargetProperty="Opacity"
                    From="0" To="1" Duration="0:0:0.25" />
            </Storyboard>
        </Grid.Resources>

        <ScrollViewer Padding="28,20,28,28">
            <StackPanel
                x:Name="ContentRoot"
                MaxWidth="640"
                HorizontalAlignment="Center"
                Spacing="16"
                Opacity="0">

                <InfoBar x:Name="UpdateNotice" Title="Update available" Severity="Informational" IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateNoticeButton" Content="Review update" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Magnification -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Magnification" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ZoomReadoutText" Text="1.25×" Style="{StaticResource HeroReadoutStyle}" />
                            <TextBlock
                                x:Name="ZoomStatusText"
                                Grid.Column="1"
                                Text="Normal view"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,10"
                                Style="{StaticResource SecondaryCaptionStyle}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ZoomMinusButton"
                                Content="−"
                                Width="48"
                                AutomationProperties.Name="Decrease magnification" />
                            <Button
                                x:Name="ZoomPlusButton"
                                Content="+"
                                Width="48"
                                AutomationProperties.Name="Increase magnification" />
                            <Button
                                x:Name="ZoomToggleButton"
                                Content="Turn zoom on"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="150"
                                AutomationProperties.Name="Turn magnification on" />
                        </StackPanel>
                        <TextBlock x:Name="ZoomBindingText" Style="{StaticResource SecondaryCaptionStyle}" />
                            <ToggleSwitch
                                x:Name="SoundToggle"
                                Header="Play sound on toggle"
                                VerticalAlignment="Bottom" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Crosshair" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="CrosshairToggle" Grid.Column="1" OnContent="On" OffContent="Off"
                                          AutomationProperties.Name="Show centered crosshair" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="CrosshairAssetBox" Header="Design" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="CrosshairMonitorBox" Header="Monitor" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#292E39" CornerRadius="6" Padding="8" MinHeight="100">
                                <Image x:Name="CrosshairPreview" Stretch="Uniform" AutomationProperties.Name="Crosshair preview" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ImportCrosshairImageButton" Content="Load image" />
                            <Button x:Name="ImportCrosshairCodeButton" Content="Paste code / link" />
                            <Button x:Name="ImportCrosshairLibraryButton" Content="Import from Crosshair X" />
                            <Button x:Name="DeleteCrosshairButton" Content="Delete design"
                                    AutomationProperties.Name="Delete selected crosshair design" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Size" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="CrosshairSizeSlider" Grid.Column="1" Minimum="25" Maximum="400" StepFrequency="5"
                                    AutomationProperties.Name="Crosshair size percent" />
                            <TextBlock x:Name="CrosshairSizeText" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />
                            <TextBlock Grid.Row="1" Text="Opacity" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="CrosshairOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="100" StepFrequency="5"
                                    AutomationProperties.Name="Crosshair opacity percent" />
                            <TextBlock x:Name="CrosshairOpacityText" Grid.Row="1" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />
                        </Grid>
                        <TextBlock x:Name="CrosshairStatusText" TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                        <TextBlock x:Name="CrosshairShortcutText" TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Display Color -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Display Color" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ProfileComboBox"
                                Header="Color profile"
                                PlaceholderText="No profile selected"
                                HorizontalAlignment="Stretch" />
                            <ToggleSwitch
                                x:Name="ColorToggle"
                                Grid.Column="1"
                                Header="Display color"
                                OnContent="On"
                                OffContent="Off"
                                VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="FilterStatusText" Style="{StaticResource SecondaryCaptionStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Gamma" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="50" Maximum="250" AutomationProperties.Name="Gamma" />
                            <TextBlock x:Name="GammaValueText" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />

                            <TextBlock Grid.Row="1" Text="Brightness" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Minimum="-20" Maximum="30" AutomationProperties.Name="Brightness" />
                            <TextBlock x:Name="BrightnessValueText" Grid.Row="1" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />

                            <TextBlock Grid.Row="2" Text="Contrast" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="ContrastSlider" Grid.Row="2" Grid.Column="1" Minimum="50" Maximum="150" AutomationProperties.Name="Contrast" />
                            <TextBlock x:Name="ContrastValueText" Grid.Row="2" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />

                            <TextBlock Grid.Row="3" Text="Saturation" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="SaturationSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="200" AutomationProperties.Name="Saturation" />
                            <TextBlock x:Name="SaturationValueText" Grid.Row="3" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />

                            <TextBlock Grid.Row="4" Text="Dark detail" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="ShadowsSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="50" AutomationProperties.Name="Dark detail" />
                            <TextBlock x:Name="ShadowsValueText" Grid.Row="4" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />

                            <TextBlock Grid.Row="5" Text="Highlight protection" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="HighlightsSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="50" AutomationProperties.Name="Highlight protection" />
                            <TextBlock x:Name="HighlightsValueText" Grid.Row="5" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />
                        </Grid>

                        <TextBlock
                            Text="Color applies when you release the slider."
                            Style="{StaticResource SecondaryCaptionStyle}" />
                        <TextBlock x:Name="ProfileStateText" Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Color Profiles -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Color Profiles" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveProfileButton" Content="Save changes" />
                            <Button x:Name="RevertProfileButton" Content="Revert" />
                            <Button x:Name="NewProfileButton" Content="New profile" />
                            <Button x:Name="RenameProfileButton" Content="Rename" />
                            <Button x:Name="DeleteProfileButton" Content="Delete" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}" />
                        <ToggleSwitch x:Name="StartupColorToggle" Header="Enable monitor preset when the app opens" />
                        <ToggleSwitch x:Name="WindowsStartupToggle" Header="Start with Windows" />
                        <TextBlock Text="Runs in the system tray when you sign in."
                                   Style="{StaticResource SecondaryCaptionStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Quiet volume" Style="{StaticResource SliderRowLabelStyle}" />
                            <Slider x:Name="QuietVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                                    AutomationProperties.Name="Quiet volume percent of current app volume" />
                            <TextBlock x:Name="QuietVolumeText" Grid.Column="2" Style="{StaticResource SliderValueStyle}" />
                        </Grid>
                        <TextBlock Text="Percentage of the focused app’s current volume used when you hold the volume shortcut."
                                   TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                        <Expander Header="Hotkeys &amp; bindings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Choose any keyboard key or mouse button, with optional modifiers. Assigning a shortcut already in use swaps the two bindings."
                                           TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                                <StackPanel x:Name="BindingRows" Spacing="8" />
                                <TextBlock Text="Tap the volume shortcut to mute or unmute. Hold for at least 0.5 seconds, then release to reduce or restore the volume."
                                           TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                                <Button x:Name="ResetBindingsButton" Content="Restore default bindings" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock x:Name="UpdateVersionText" Style="{StaticResource SecondaryCaptionStyle}" />
                        <ToggleSwitch x:Name="AutomaticUpdatesToggle" Header="Check for updates at startup" IsEnabled="False" />
                        <TextBlock Text="Checks once after launch. Use Check for updates whenever you want to check again."
                                   TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Content="Check for updates" IsEnabled="False" />
                            <Button x:Name="InstallUpdateButton" Content="Update and restart" Visibility="Collapsed" />
                            <HyperlinkButton x:Name="UpdateReleasesLink" Content="Release notes" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Warnings -->
                <InfoBar
                    x:Name="WarningBar"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="False" />

                <!-- Footer -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Closing this window keeps Zoom in the system tray."
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AppDetailsButton" Content="App details" />
                        <Button x:Name="ResetViewButton" Content="Reset view" />
                        <Button x:Name="HideButton" Content="Hide" />
                        <Button x:Name="ExitButton" Content="Exit" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
